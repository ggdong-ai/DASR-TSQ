      },
      "sensitivity_profiles": {
        "activity_primary": {
          "weight_dual_activity": 0.6,
          "weight_qed": 0.2,
          "weight_sa": 0.2,
          "rationale": "Primary profile. Dual-target activity is the main objective, while QED and SA remain explicit soft constraints."
        },
        "activity_strict": {
          "weight_dual_activity": 0.7,
          "weight_qed": 0.15,
          "weight_sa": 0.15,
          "rationale": "Sensitivity profile with stronger pressure on dual-target activity."
        },
        "balanced": {
          "weight_dual_activity": 0.5,
          "weight_qed": 0.25,
          "weight_sa": 0.25,
          "rationale": "Sensitivity profile balancing activity, drug-likeness and accessibility."
        }
      },
      "reward_formula": {
        "dual_min_pic50": "min(pred_gsk3b_pic50, pred_jnk3_pic50)",
        "dual_activity_reward": "clip((dual_min_pic50 - activity_lower_pic50) / (activity_upper_pic50 - activity_lower_pic50), 0, 1)",
        "sa_reward": "clip((10 - SA_score) / 9, 0, 1)",
        "final_reward": "weight_dual_activity * dual_activity_reward + weight_qed * QED + weight_sa * SA_reward"
      },
      "primary_reward_interpretation": "The primary profile is activity-centered because the main manuscript objective is dual-target GSK3β/JNK3 molecular core. QED and SA are retained as soft constraints.",
      "qed_source": "RDKit QED implementation",
      "sa_score_source": "Ertl-Schuffenhauer synthetic accessibility score",
