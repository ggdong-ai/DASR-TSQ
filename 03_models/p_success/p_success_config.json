        "sa_score_range": "1.0 easy to synthesize; 10.0 difficult to synthesize",
        "sa_reward_formula": "SA_reward = clip((10 - SA_score) / 9, 0, 1)"
      },
      "oracle_predictor": {
        "gsk3b_oracle_path": "D:\\pycharm\\project\\tsq_mcts_rebuild\\03_models\\final_oracles\\final_gsk3b_rf_oracle.joblib",
